---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { getReadingMinutes } from "@/utils/getReadingTime";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  layout?: "default" | "featured";
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  layout = "default",
  id,
  data,
  filePath,
  body,
} = Astro.props;

const { title, description, tags, ...props } = data;
const locale = Astro.currentLocale ?? config.site.lang;
const readingMinutes = getReadingMinutes(body ?? "");
---

<li
  class:list={[
    "group border-border border-b py-6",
    { "sm:py-8": layout === "featured" },
  ]}
>
  <article
    class:list={[
      "grid gap-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-8",
      { "sm:grid-cols-[11rem_minmax(0,1fr)]": layout === "featured" },
    ]}
  >
    <div>
      <Datetime {...props} />
      <p class="text-muted-foreground mt-2 text-xs">
        {readingMinutes} 分钟阅读
      </p>
      <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
        {
          tags.slice(0, 3).map(tag => (
            <a
              href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}
              class="text-muted-foreground hover:text-accent text-xs no-underline transition-colors"
            >
              #{tag}
            </a>
          ))
        }
      </div>
    </div>
    <div>
      <a
        href={getPostUrl(id, filePath, locale)}
        class="text-foreground group-hover:text-accent inline-block no-underline transition-colors"
      >
        <Heading
          transition:name={toTransitionName(title)}
          class:list={[
            "text-xl leading-snug font-semibold",
            { "sm:text-2xl": layout === "featured" },
          ]}
        >
          {title}
        </Heading>
      </a>
      <p class="text-muted-foreground mt-3 line-clamp-3 leading-7">
        {description}
      </p>
      <a
        href={getPostUrl(id, filePath, locale)}
        class="text-accent mt-4 inline-flex items-center gap-1 text-sm font-medium no-underline"
        aria-label={`阅读全文：${title}`}
      >
        阅读全文
        <IconArrowRight
          class="size-4 transition-transform group-hover:translate-x-0.5 rtl:-rotate-180"
        />
      </a>
    </div>
  </article>
</li>
