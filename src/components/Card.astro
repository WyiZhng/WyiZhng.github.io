---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, ...props } = data;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li
  class="group glass-card hover:border-accent/50 hover:shadow-accent/10 relative overflow-hidden p-5 transition duration-200 hover:-translate-y-1 hover:shadow-2xl"
>
  <div
    class="from-accent via-accent/45 pointer-events-none absolute inset-y-0 left-0 w-1 bg-gradient-to-b to-transparent opacity-75"
    aria-hidden="true"
  >
  </div>
  <Datetime {...props} class="mb-3" />
  <a
    href={getPostUrl(id, filePath, locale)}
    class="text-foreground group-hover:text-accent inline-block no-underline transition"
  >
    <Heading
      transition:name={toTransitionName(title)}
      class="text-xl leading-snug font-bold"
    >
      {title}
    </Heading>
  </a>
  <p class="text-muted-foreground mt-3 line-clamp-3">{description}</p>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-2">
      {
        tags.slice(0, 3).map(tag => (
          <a
            href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}
            class="border-border bg-muted/50 text-muted-foreground hover:border-accent/50 hover:text-accent rounded-full border px-2.5 py-1 text-xs no-underline transition"
          >
            #{tag}
          </a>
        ))
      }
    </div>
    <span
      class="text-accent text-sm font-semibold opacity-0 transition group-hover:opacity-100"
    >
      阅读 →
    </span>
  </div>
</li>
