---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  eyebrow?: string;
  searchable?: boolean;
  class?: string;
};

const {
  pageTitle,
  pageDesc,
  eyebrow = "INDEX",
  searchable = false,
  class: className,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  data-pagefind-body={searchable ? true : undefined}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <header class="border-border border-b py-10 sm:py-14">
    <p class="text-accent text-xs font-semibold tracking-[0.18em]">
      {eyebrow}
    </p>
    <h1 class="font-editorial mt-3 text-3xl font-semibold sm:text-5xl">
      {pageTitle}
    </h1>
    {
      pageDesc && (
        <p class="text-muted-foreground mt-4 max-w-2xl leading-7">{pageDesc}</p>
      )
    }
  </header>
  <div class="py-8 sm:py-10">
    <slot />
  </div>
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
