---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navLinkClass =
  "block px-3 py-2 text-center text-sm font-medium no-underline transition-colors hover:text-accent sm:px-1";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent border-border absolute inset-s-4 -top-full z-50 border px-3 py-2 transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="border-border bg-background sticky top-0 z-40 border-b">
  <div
    class="app-layout flex min-h-[var(--header-height)] items-center justify-between gap-4"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="text-foreground py-2 text-lg font-semibold whitespace-nowrap no-underline"
      aria-label={`${site.title} - ${t.nav.home}`}
    >
      {site.title}
    </a>

    <nav
      id="nav-menu"
      class="relative ms-auto flex flex-1 items-center justify-end"
      aria-label="主导航"
    >
      <button
        id="menu-btn"
        class="focus-outline relative size-10 p-2 sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>

      <ul
        id="menu-items"
        class="border-border bg-background absolute top-[calc(100%+0.85rem)] right-0 hidden w-52 grid-cols-2 border p-3 shadow-sm sm:static sm:flex sm:w-auto sm:items-center sm:gap-4 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
      >
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "")}
            class:list={[navLinkClass, { "active-nav": isActive("/") }]}
            aria-current={isActive("/") ? "page" : undefined}
          >
            {t.nav.home}
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[navLinkClass, { "active-nav": isActive("/posts") }]}
            aria-current={isActive("/posts") ? "page" : undefined}
          >
            {t.nav.posts}
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={[navLinkClass, { "active-nav": isActive("/tags") }]}
            aria-current={isActive("/tags") ? "page" : undefined}
          >
            {t.nav.tags}
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[navLinkClass, { "active-nav": isActive("/about") }]}
            aria-current={isActive("/about") ? "page" : undefined}
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.showArchives && (
            <li class="flex items-center justify-center">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline relative size-10 justify-center sm:size-8",
                  { "text-accent": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
                aria-current={isActive("/archives") ? "page" : undefined}
              >
                <IconArchive class="size-5" />
                <span class="sr-only">{t.nav.archives}</span>
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="flex items-center justify-center">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={[
                  "focus-outline relative size-10 justify-center sm:size-8",
                  { "text-accent": isActive("/search") },
                ]}
                title={t.nav.search}
                aria-label={t.nav.search}
                aria-current={isActive("/search") ? "page" : undefined}
              >
                <IconSearch class="size-5" />
                <span class="sr-only">{t.nav.search}</span>
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline hover:text-accent relative size-10 p-2 sm:size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector<HTMLElement>("#menu-items");
    const menuIcon = document.querySelector<HTMLElement>("#menu-icon");
    const closeIcon = document.querySelector<HTMLElement>("#close-icon");
    const nav = document.querySelector<HTMLElement>("#nav-menu");

    if (
      !menuBtn ||
      !menuItems ||
      !menuIcon ||
      !closeIcon ||
      !nav ||
      menuBtn.dataset.bound === "true"
    ) {
      return;
    }

    menuBtn.dataset.bound = "true";
    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    const setOpen = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
      menuItems.classList.toggle("hidden", !open);
      menuItems.classList.toggle("grid", open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
    };

    menuBtn.addEventListener("click", () => {
      setOpen(menuBtn.getAttribute("aria-expanded") !== "true");
    });

    menuItems.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => setOpen(false));
    });

    nav.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        setOpen(false);
        menuBtn.focus();
      }
    });
  }

  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
