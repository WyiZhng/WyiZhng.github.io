---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { groupPostsByCategory } from "@/utils/postCategories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const groupedPosts = groupPostsByCategory(sortedPosts);
const activeGroups = groupedPosts.filter(group => group.posts.length > 0);
const homePath = getRelativeLocaleUrl(locale, "");
const topics = ["Vue", "Git", "AI", "YOLO", "工程化"];
const stats = [
  { label: "文章", value: sortedPosts.length },
  { label: "方向", value: topics.length },
  { label: "部署", value: "Pages" },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="relative py-12 sm:py-16">
      <div class="grid gap-6 lg:grid-cols-[1.35fr_0.9fr] lg:items-stretch">
        <div class="glass-card relative overflow-hidden p-6 sm:p-8">
          <div
            class="bg-accent/18 pointer-events-none absolute -top-28 -right-24 h-72 w-72 rounded-full blur-3xl"
            aria-hidden="true"
          >
          </div>
          <p class="text-accent mb-5 text-sm font-semibold tracking-[0.24em]">
            FRONTEND · AI · NOTES
          </p>
          <h1
            class="gradient-text max-w-2xl text-5xl leading-tight font-black text-balance sm:text-7xl"
          >
            YI's Blog
          </h1>
          <p class="text-muted-foreground mt-6 max-w-2xl text-lg leading-8">
            记录技术学习、项目实践和问题复盘，把零散经验沉淀成能反复查阅的工程笔记。
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="bg-accent text-accent-foreground shadow-accent/20 hover:text-accent-foreground rounded-full px-5 py-2.5 no-underline shadow-lg transition hover:-translate-y-0.5"
            >
              开始阅读
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "search")}
              class="border-border bg-background/80 hover:text-accent rounded-full border px-5 py-2.5 no-underline backdrop-blur transition hover:-translate-y-0.5"
            >
              搜索文章
            </LinkButton>
            <a
              target="_blank"
              href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
              class="border-border bg-background/80 hover:text-accent inline-flex items-center rounded-full border px-3 py-2.5 backdrop-blur transition hover:-translate-y-0.5"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="stroke-accent scale-110 stroke-3 rtl:-rotate-90"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
        </div>

        <aside class="glass-card flex flex-col justify-between gap-6 p-6">
          <div class="flex items-center gap-4">
            <img
              src="/image/avatar.jpeg"
              alt="WyiZhng avatar"
              class="border-border shadow-accent/10 size-20 rounded-2xl border object-cover shadow-lg"
            />
            <div>
              <p class="text-muted-foreground text-sm">Hi, I'm</p>
              <p class="text-2xl font-black">WyiZhng</p>
              <p class="text-muted-foreground mt-1 text-sm">
                正在把技术碎片整理成自己的知识地图。
              </p>
            </div>
          </div>

          <ul class="grid grid-cols-3 gap-3">
            {
              stats.map(stat => (
                <li class="border-border bg-muted/45 rounded-xl border p-3 text-center">
                  <p class="text-accent text-xl font-black">{stat.value}</p>
                  <p class="text-muted-foreground mt-1 text-xs">{stat.label}</p>
                </li>
              ))
            }
          </ul>

          <ul class="flex flex-wrap gap-2">
            {topics.map(topic => <li class="soft-chip">{topic}</li>)}
          </ul>

          {
            socials.length > 0 && (
              <div class="border-border border-t pt-4">
                <div class="text-muted-foreground mb-2 text-sm">
                  {t.home.socialLinks}
                </div>
                <Socials />
              </div>
            )
          }
        </aside>
      </div>
    </section>

    <section
      id="knowledge-map"
      class="grid gap-6 pb-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:items-start"
    >
      <aside class="glass-card p-4 lg:sticky lg:top-24">
        <p class="text-accent px-2 text-xs font-semibold tracking-[0.22em]">
          CATEGORIES
        </p>
        <nav class="mt-4 grid gap-1" aria-label="知识库专题">
          {
            activeGroups.map(group => (
              <a
                href={`#${group.id}`}
                class="hover:bg-muted/70 hover:text-accent rounded-lg px-3 py-2 text-sm no-underline transition"
              >
                <span class="font-semibold">{group.title}</span>
                <span class="text-muted-foreground ms-2 text-xs">
                  {group.posts.length}
                </span>
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="grid gap-5">
        {
          activeGroups.map(group => (
            <section id={group.id} class="glass-card scroll-mt-28 p-5 sm:p-6">
              <div class="mb-5">
                <p class="text-accent text-xs font-semibold tracking-[0.22em]">
                  {group.id.toUpperCase()}
                </p>
                <h2 class="mt-1 text-2xl font-black">{group.title}</h2>
                <p class="text-muted-foreground mt-2 max-w-2xl text-sm leading-7">
                  {group.description}
                </p>
              </div>

              <ul class="grid gap-3">
                {group.posts.map(post => (
                  <li class="border-border bg-background/65 hover:border-accent/60 rounded-xl border p-4 transition">
                    <a
                      href={getPostUrl(post.id, post.filePath, locale)}
                      class="group block no-underline"
                    >
                      <div class="flex flex-wrap items-center gap-3">
                        <Datetime {...post.data} />
                        <div class="flex flex-wrap gap-2">
                          {post.data.tags.slice(0, 3).map(tag => (
                            <span class="text-muted-foreground bg-muted/60 rounded-full px-2 py-0.5 text-xs">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      </div>
                      <h3 class="group-hover:text-accent mt-3 text-lg font-bold transition">
                        {post.data.title}
                      </h3>
                      <p class="text-muted-foreground mt-2 line-clamp-2 text-sm leading-7">
                        {post.data.description}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-8",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-8 pb-8">
          <div class="mb-4 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-sm font-semibold tracking-[0.18em]">
                LATEST
              </p>
              <h2 class="mt-1 text-2xl font-bold tracking-wide">
                {t.home.recentPosts}
              </h2>
            </div>
          </div>
          <ul class="grid gap-4">
            {recentPosts.slice(0, config.posts.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-10 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="border-border bg-background/80 hover:text-accent rounded-full border px-5 py-2.5 no-underline shadow-sm backdrop-blur transition hover:-translate-y-0.5"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
