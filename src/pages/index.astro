---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSortedNotes } from "@/utils/getSortedNotes";
import { getNoteUrl } from "@/utils/getNoteUrl";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const selectedPosts = sortedPosts.filter(({ data }) => data.featured);
const featuredPosts = (
  selectedPosts.length > 0 ? selectedPosts : sortedPosts
).slice(0, 2);
const featuredIds = new Set(featuredPosts.map(post => post.id));
const recentPosts = sortedPosts.filter(post => !featuredIds.has(post.id));
const notes = getSortedNotes(await getCollection("notes")).slice(0, 3);
const projects = (await getCollection("projects"))
  .sort(
    (projectA, projectB) =>
      Number(projectB.data.featured) - Number(projectA.data.featured) ||
      projectA.data.order - projectB.data.order
  )
  .slice(0, 3);
const homePath = getRelativeLocaleUrl(locale, "");
const resolveProjectHref = (href: string) =>
  /^https?:\/\//.test(href)
    ? href
    : getRelativeLocaleUrl(locale, href.replace(/^\/+/, ""));
const topics = [
  "金融市场与 FICC",
  "人工智能",
  "数据分析",
  "研究方法",
  "工程实践",
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="border-border grid gap-12 border-b py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-end lg:py-24"
    >
      <div class="max-w-3xl">
        <p class="text-accent text-xs font-semibold tracking-[0.18em]">
          WYIZHNG / RESEARCH NOTES
        </p>
        <h1
          class="font-editorial mt-6 text-4xl leading-tight font-semibold text-balance sm:text-6xl"
        >
          研究市场、技术与复杂问题
        </h1>
        <p class="text-muted-foreground mt-7 max-w-2xl text-lg leading-8">
          这里记录金融市场、FICC、人工智能、数据分析与研究方法，也保留工程实践和个人成长中的长期笔记。
        </p>

        <ul
          class="text-muted-foreground mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm"
          aria-label="研究主题"
        >
          {topics.map(topic => <li>{topic}</li>)}
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="bg-accent text-accent-foreground hover:text-accent-foreground rounded-md px-4 py-2.5 font-medium no-underline transition-opacity hover:opacity-90"
          >
            阅读文章
            <IconArrowRight class="size-4 rtl:-rotate-180" />
          </LinkButton>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "about")}
            class="border-border hover:border-border-strong rounded-md border px-4 py-2.5 font-medium no-underline transition-colors"
          >
            关于我
          </LinkButton>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="text-muted-foreground hover:text-accent inline-flex size-10 items-center justify-center transition-colors"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss width={19} height={19} class="stroke-current stroke-2" />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>
      </div>

      <aside class="border-border border-s ps-6">
        <img
          src={getAssetPath("image/avatar.jpeg")}
          alt="WyiZhng"
          width="240"
          height="240"
          class="aspect-square w-28 rounded-md object-cover sm:w-36 lg:w-full"
        />
        <p class="mt-5 text-lg font-semibold">WyiZhng</p>
        <p class="text-muted-foreground mt-1 text-sm leading-6">
          持续学习者、技术实践者与研究记录者。
        </p>
        {
          socials.length > 0 && (
            <div class="mt-3">
              <Socials />
            </div>
          )
        }
      </aside>
    </section>

    <section
      id="about-overview"
      class="border-border grid gap-6 border-b py-10 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-10 sm:py-12"
    >
      <p class="text-accent text-xs font-semibold tracking-[0.18em]">
        00 / PROFILE
      </p>
      <div class="max-w-3xl">
        <h2 class="text-2xl font-semibold">在技术与市场之间建立可复用的理解</h2>
        <p class="text-muted-foreground mt-4 leading-8">
          我关注金融市场、FICC、人工智能与数据分析，并通过长期写作沉淀研究方法、工程经验和持续学习中的判断。
        </p>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "about")}
          class="text-accent mt-5 text-sm font-medium no-underline"
        >
          查看研究档案
          <IconArrowRight class="size-4 rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b py-14 sm:py-18">
          <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.18em]">
                01 / EDITOR'S PICK
              </p>
              <h2 class="mt-2 text-2xl font-semibold">{t.home.featured}</h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-muted-foreground hover:text-accent text-sm no-underline"
            >
              {t.home.allPosts}
              <IconArrowRight class="size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul class="border-border border-t">
            {featuredPosts.map(data => (
              <Card variant="h3" layout="featured" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="border-border border-b py-14 sm:py-18"
        >
          <div class="mb-7">
            <p class="text-accent text-xs font-semibold tracking-[0.18em]">
              02 / LATEST
            </p>
            <h2 class="mt-2 text-2xl font-semibold">{t.home.recentPosts}</h2>
          </div>
          <ul class="border-border border-t">
            {recentPosts.slice(0, config.posts.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-8">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="border-border hover:border-border-strong rounded-md border px-4 py-2.5 text-sm font-medium no-underline transition-colors"
            >
              {t.home.allPosts}
              <IconArrowRight class="size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section id="projects" class="border-border border-b py-14 sm:py-18">
          <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.18em]">
                03 / PROJECTS
              </p>
              <h2 class="mt-2 text-2xl font-semibold">项目与实践</h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "projects")}
              class="text-muted-foreground hover:text-accent text-sm no-underline"
            >
              查看全部项目
              <IconArrowRight class="size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>

          <ul class="border-border border-t">
            {projects.map(project => (
              <li class="border-border grid gap-4 border-b py-6 sm:grid-cols-[9rem_minmax(0,1fr)_auto] sm:items-start sm:gap-8">
                <div class="text-muted-foreground text-xs leading-6">
                  <p class="text-accent font-semibold tracking-[0.12em]">
                    {project.data.status}
                  </p>
                  <p>{project.data.period}</p>
                </div>
                <article>
                  <h3 class="text-xl font-semibold">{project.data.title}</h3>
                  <p class="text-muted-foreground mt-2 leading-7">
                    {project.data.description}
                  </p>
                  <p class="text-muted-foreground mt-3 text-xs">
                    {project.data.stack.join(" / ")}
                  </p>
                </article>
                {project.data.href && (
                  <a
                    href={resolveProjectHref(project.data.href)}
                    target={
                      project.data.href.startsWith("http")
                        ? "_blank"
                        : undefined
                    }
                    rel={
                      project.data.href.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined
                    }
                    class="text-accent inline-flex items-center gap-1 text-sm font-medium no-underline"
                  >
                    查看
                    <IconArrowRight class="size-4 rtl:-rotate-180" />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section id="notes" class="py-14 sm:py-18">
          <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-accent text-xs font-semibold tracking-[0.18em]">
                04 / NOTES
              </p>
              <h2 class="mt-2 text-2xl font-semibold">短笔记</h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "notes")}
              class="text-muted-foreground hover:text-accent text-sm no-underline"
            >
              查看全部笔记
              <IconArrowRight class="size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>

          <ul class="border-border border-t">
            {notes.map(note => (
              <li class="border-border grid gap-3 border-b py-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-8">
                <Datetime pubDatetime={note.data.pubDatetime} />
                <article>
                  <a
                    href={getNoteUrl(note.id, locale)}
                    class="hover:text-accent no-underline transition-colors"
                  >
                    <h3 class="text-lg font-semibold">{note.data.title}</h3>
                  </a>
                  <p class="text-muted-foreground mt-2 leading-7">
                    {note.data.summary}
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
