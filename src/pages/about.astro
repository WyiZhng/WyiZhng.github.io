---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);

const focusAreas = [
  "金融市场与 FICC",
  "人工智能与 Agent",
  "数据分析与可视化",
  "研究方法与写作",
  "工程实践与复盘",
];

const roadmap = [
  {
    title: "建立可靠的内容基础",
    desc: "保留文章 URL 与 Markdown 内容，让搜索、标签、RSS 和 SEO 持续可用。",
  },
  {
    title: "形成稳定的研究主题",
    desc: "围绕市场、技术与方法论积累可以相互连接的长期内容。",
  },
  {
    title: "让记录持续被修正",
    desc: "把短笔记、项目复盘和长文放在同一体系中，允许观点逐步完善。",
  },
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout pb-10">
    <header
      class="border-border grid gap-8 border-b py-12 sm:py-16 lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-end"
    >
      <img
        src={getAssetPath("image/avatar.jpeg")}
        alt="WyiZhng"
        width="240"
        height="240"
        class="aspect-square w-36 rounded-md object-cover sm:w-48 lg:w-full"
      />
      <div class="max-w-3xl">
        <p class="text-accent text-xs font-semibold tracking-[0.18em]">
          ABOUT / 关于
        </p>
        <h1 class="font-editorial mt-4 text-4xl font-semibold sm:text-6xl">
          WyiZhng
        </h1>
        <p class="text-muted-foreground mt-5 max-w-2xl text-lg leading-8">
          关注市场、技术与研究方法，尝试把学习过程整理成可以验证、复用和持续修正的公开记录。
        </p>
      </div>
    </header>

    <section
      class="grid gap-10 py-12 sm:py-16 lg:grid-cols-[15rem_minmax(0,var(--content-width))] lg:gap-16"
    >
      <aside>
        <p class="text-accent text-xs font-semibold tracking-[0.18em]">
          FOCUS / 方向
        </p>
        <ul class="border-border mt-5 border-t text-sm">
          {
            focusAreas.map(area => (
              <li class="border-border border-b py-3">{area}</li>
            ))
          }
        </ul>
        <div class="mt-5">
          <Socials />
        </div>
      </aside>

      <article class="app-prose max-w-none">
        <Content />
      </article>
    </section>

    <section class="border-border border-t py-12 sm:py-16">
      <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="text-accent text-xs font-semibold tracking-[0.18em]">
            ROADMAP / 路线
          </p>
          <h2 class="mt-3 text-2xl font-semibold">这个博客如何继续生长</h2>
        </div>
        <ol class="border-border border-t">
          {
            roadmap.map((item, index) => (
              <li class="border-border grid gap-3 border-b py-5 sm:grid-cols-[3rem_minmax(0,1fr)]">
                <span class="text-muted-foreground text-sm tabular-nums">
                  {(index + 1).toString().padStart(2, "0")}
                </span>
                <div>
                  <h3 class="font-semibold">{item.title}</h3>
                  <p class="text-muted-foreground mt-1 leading-7">
                    {item.desc}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
