---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div
  data-pagefind-ignore
  class="border-border my-8 grid grid-cols-1 border-y sm:grid-cols-2"
>
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="border-border hover:text-accent flex w-full gap-3 border-b p-5 no-underline transition-colors sm:border-e sm:border-b-0"
      >
        <IconArrowLeft class="text-accent mt-1 inline-block flex-none rtl:rotate-180" />
        <div>
          <span class="text-muted-foreground text-xs tracking-[0.16em]">
            {t.post.previousPost}
          </span>
          <div class="mt-1 font-semibold">{prevPost.title}</div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="hover:text-accent flex w-full justify-end gap-3 p-5 text-end no-underline transition-colors sm:col-start-2"
      >
        <div>
          <span class="text-muted-foreground text-xs tracking-[0.16em]">
            {t.post.nextPost}
          </span>
          <div class="mt-1 font-semibold">{nextPost.title}</div>
        </div>
        <IconArrowRight class="text-accent mt-1 inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</div>
