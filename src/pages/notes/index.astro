---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedNotes } from "@/utils/getSortedNotes";
import { getNoteUrl } from "@/utils/getNoteUrl";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const notes = getSortedNotes(await getCollection("notes"));
---

<Layout
  title={`${t.pages.notesTitle} | ${config.site.title}`}
  description={t.pages.notesDesc}
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle={t.pages.notesTitle}
    pageDesc={t.pages.notesDesc}
    eyebrow="NOTES / 短笔记"
  >
    <ul class="border-border border-t">
      {
        notes.map(note => (
          <li class="border-border grid gap-4 border-b py-6 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-8">
            <div>
              <Datetime pubDatetime={note.data.pubDatetime} />
              <p class="text-muted-foreground mt-2 text-xs">短笔记</p>
            </div>
            <article>
              <a
                href={getNoteUrl(note.id, locale)}
                class="hover:text-accent no-underline transition-colors"
              >
                <h2 class="text-xl font-semibold">{note.data.title}</h2>
              </a>
              <p class="text-muted-foreground mt-2 leading-7">
                {note.data.summary}
              </p>
              <ul class="text-muted-foreground mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs">
                {note.data.tags.map(tag => (
                  <li>#{tag}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
