---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedNotes } from "@/utils/getSortedNotes";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths() {
  const notes = getSortedNotes(await getCollection("notes"));
  return notes.map(note => ({
    params: { slug: slugifyStr(note.id) },
    props: { note },
  }));
}

type Props = { note: CollectionEntry<"notes"> };

const { note } = Astro.props;
const { Content } = await render(note);
---

<Layout
  title={`${note.data.title} | ${config.site.title}`}
  description={note.data.summary}
>
  <Header />
  <Breadcrumb />

  <main
    id="main-content"
    class="app-layout"
    data-pagefind-body
    data-pagefind-filter="type:笔记"
  >
    <article class="content-measure mx-auto py-8 sm:py-12">
      <header class="border-border border-b pb-8">
        <p class="text-accent text-xs font-semibold tracking-[0.18em]">
          NOTE / 短笔记
        </p>
        <h1
          class="font-editorial mt-4 text-3xl leading-tight font-semibold sm:text-5xl"
          data-pagefind-meta="title"
        >
          {note.data.title}
        </h1>
        <p
          class="text-muted-foreground mt-4 text-lg leading-8"
          data-pagefind-meta="description"
        >
          {note.data.summary}
        </p>
        <div class="mt-5">
          <Datetime pubDatetime={note.data.pubDatetime} size="lg" />
        </div>
        <ul
          class="text-muted-foreground mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm"
        >
          {note.data.tags.map(tag => <li>#{tag}</li>)}
        </ul>
        <div class="sr-only" aria-hidden="true">
          {
            note.data.tags.map(tag => (
              <span data-pagefind-filter="tag">{tag}</span>
            ))
          }
        </div>
      </header>

      <div class="app-prose mt-10 max-w-none">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Layout>
